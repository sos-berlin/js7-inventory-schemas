							"ftps"
						]
					}
				]
			}
		},
		{
			"required": [
				"ftp"
			],
			"not": {
				"required": [
					"ftps"
				]
			}
		},
		{
			"required": [
				"ftps"
			],
			"not": {
				"required": [
					"ftp"
				]
			}
		}
