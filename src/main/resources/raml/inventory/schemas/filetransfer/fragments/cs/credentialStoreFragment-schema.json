{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "Credential Store Fragment",
	"description": "Credential Store Fragment.",
	"_comment": "allOf is present for validator and documentation only. jsonschema2pojo uses 'extends' for code generation. allOf ensures the validator applies the base required fields.",
	"javaType": "com.sos.inventory.model.filetransfer.fragments.cs.CredentialStoreFragment",
	"extends": {
		"javaType": "com.sos.inventory.model.filetransfer.fragments.AFragment"
	},
	"allOf": [
		{
			"$ref": "../abstractFragment-schema.json"
		}
	],
	"type": "object",
	"additionalProperties": false,
	"required": [
		"file",
		"authentication"
	],
	"properties": {
		"file": {
			"$ref": "../../common/patterns/string-schema.json"
		},
		"authentication": {
			"description": "Credential store authentication. Provide either 'password' or 'keyFile'.",
			"javaType": "com.sos.inventory.model.filetransfer.fragments.cs.CredentialStoreAuthentication",
			"type": "object",
			"additionalProperties": false,
			"oneOf": [
				{
					"required": [
						"password"
					],
					"not": {
						"required": [
							"keyFile"
						]
					}
				},
				{
					"required": [
						"keyFile"
					],
					"not": {
						"required": [
							"password"
						]
					}
				}
			],
			"properties": {
				"password": {
					"description": "Password authentication.",
					"javaType": "com.sos.inventory.model.filetransfer.fragments.cs.CredentialStoreAuthPassword",
					"type": "object",
					"additionalProperties": false,
					"required": [
						"password"
					],
					"properties": {
						"password": {
							"$ref": "../../common/patterns/password-schema.json"
						}
					}
				},
				"keyFile": {
					"description": "Key file authentication.",
					"javaType": "com.sos.inventory.model.filetransfer.fragments.cs.CredentialStoreAuthKeyFile",
					"type": "object",
					"additionalProperties": false,
					"required": [
						"file"
					],
					"properties": {
						"file": {
							"$ref": "../../common/patterns/string-schema.json"
						},
						"password": {
							"$ref": "../../common/patterns/password-schema.json"
						}
					}
				}
			}
		},
		"entryPath": {
			"$ref": "../../common/patterns/string-schema.json"
		}
	}
}