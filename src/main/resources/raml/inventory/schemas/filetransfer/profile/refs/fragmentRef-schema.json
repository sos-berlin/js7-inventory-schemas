{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "Fragment Reference",
	"description": "Reference to a local or protocol fragment, identified by type. For protocol types, 'ref' is required. For LOCAL, 'ref' is not needed and the 'local' block may carry local options.",
	"javaType": "com.sos.inventory.model.filetransfer.profile.refs.FragmentRef",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"type"
	],
	"oneOf": [
		{
			"properties": {
				"type": {
					"enum": [
						"LOCAL"
					]
				}
			},
			"not": {
				"required": [
					"ref"
				]
			}
		},
		{
			"properties": {
				"type": {
					"enum": [
						"FTP",
						"SFTP",
						"SMB",
						"HTTP",
						"WEBDAV",
						"AZURE"
					]
				}
			},
			"required": [
				"ref"
			],
			"not": {
				"required": [
					"local"
				]
			}
		}
	],
	"properties": {
		"type": {
			"$ref": "../../common/objects/fragmentRefTypeForProfile-schema.json"
		},
		"ref": {
			"type": "string",
			"description": "Name of the referenced protocol fragment. Required for protocol types, omitted for LOCAL."
		},
		"local": {
			"javaType": "com.sos.inventory.model.filetransfer.profile.refs.Local",
			"description": "Local source/target options. Only allowed when type is LOCAL.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"credentialStoreRef": {
					"$ref": "../../common/patterns/string-schema.json"
				},
				"decryptionRef": {
					"$ref": "../../common/patterns/string-schema.json"
				},
				"processing": {
					"$ref": "../../common/objects/processing-schema.json"
				},
				"rename": {
					"$ref": "../common/rename-schema.json"
				}
			}
		}
	}
}